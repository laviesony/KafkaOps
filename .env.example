# Sample environment configuration
# Copy this to .env and customize

# Kafka Configuration
KAFKAOPS_KAFKA_BROKERS=localhost:9092
KAFKAOPS_DLQ_TOPIC=your-dlq-topic

# Schema Registry (optional)
KAFKAOPS_SCHEMA_REGISTRY_URL=http://localhost:8081

# Server Configuration
KAFKAOPS_SERVER_ADDR=:8080
KAFKAOPS_SQLITE_DSN=kafkaops.db

# TLS Configuration (optional)
KAFKAOPS_KAFKA_TLS=false

# SASL Authentication (optional)
# KAFKAOPS_KAFKA_SASL_MECHANISM=PLAIN
# KAFKAOPS_KAFKA_SASL_USERNAME=your-username
# KAFKAOPS_KAFKA_SASL_PASSWORD=your-password
